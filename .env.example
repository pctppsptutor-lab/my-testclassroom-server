# Copy to .env (or set in your process manager). All values are read once at startup.
PORT=8080
# Comma-separated exact origins of the pages that host the games (CDN / static host).
ALLOWED_ORIGINS=https://static-mass.edupia.vn
# Replace auth.js with Edupia SSO; until then teachers type this key once per tab.
TEACHER_KEY=change-me-long-random
# Bearer token for /admin (content owner). Use a long random value; rotate if leaked.
ADMIN_TOKEN=change-me-another-long-random
# Hosts the server may fetch question banks from (exact hostnames, comma-separated).
CONTENT_HOSTS=docs.google.com,static-mass.edupia.vn
# Where source settings are stored (JSON file). Mount a persistent volume here.
DATA_DIR=./data
# Optional: serve game folders for LAN testing (NOT for production)
# GAMES_DIR=../games
